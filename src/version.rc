#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CPA_VERSION_MAJOR, CPA_VERSION_MINOR, CPA_VERSION_PATCH, 0
 PRODUCTVERSION CPA_VERSION_MAJOR, CPA_VERSION_MINOR, CPA_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TrafficMonitor CPA plugin"
            VALUE "FileVersion",     CPA_VERSION_STR
            VALUE "InternalName",    "TrafficMonitorCPA"
            VALUE "OriginalFilename","TrafficMonitorCPA.dll"
            VALUE "ProductName",     "TrafficMonitorCPA"
            VALUE "ProductVersion",  CPA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
