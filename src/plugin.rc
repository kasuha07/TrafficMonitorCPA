#pragma code_page(65001)

#include <winres.h>
#include "version.h"
#include "resource.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_OPTIONS DIALOGEX 0, 0, 280, 202
STYLE DS_SETFONT | DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CPAQuota 选项"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "CPA 地址：", IDC_STATIC, 10, 12, 60, 10
    EDITTEXT        IDC_URL, 75, 10, 195, 13, ES_AUTOHSCROLL
    LTEXT           "管理密钥：", IDC_STATIC, 10, 31, 60, 10
    EDITTEXT        IDC_KEY, 75, 29, 195, 13, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "刷新间隔（秒）：", IDC_STATIC, 10, 50, 65, 10
    EDITTEXT        IDC_REFRESH, 75, 48, 50, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "查询账号：", IDC_STATIC, 10, 69, 60, 10
    AUTOCHECKBOX    "Codex", IDC_ENABLE_CODEX, 75, 68, 50, 12
    AUTOCHECKBOX    "Claude", IDC_ENABLE_CLAUDE, 130, 68, 50, 12
    AUTOCHECKBOX    "Antigravity", IDC_ENABLE_ANTIGRAVITY, 185, 68, 70, 12
    LTEXT           "多账号汇总：", IDC_STATIC, 10, 88, 60, 10
    COMBOBOX        IDC_AGGREGATE, 75, 86, 150, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "低额度提醒：", IDC_STATIC, 10, 107, 60, 10
    EDITTEXT        IDC_ALERT, 75, 105, 30, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%（剩余低于此值时通知，0 为关闭）", IDC_STATIC, 109, 107, 160, 10
    LTEXT           "", IDC_STATUS, 10, 122, 260, 50
    PUSHBUTTON      "测试连接", IDC_TEST, 10, 180, 60, 14
    DEFPUSHBUTTON   "确定", IDOK, 156, 180, 55, 14
    PUSHBUTTON      "取消", IDCANCEL, 215, 180, 55, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CPA_VERSION_MAJOR, CPA_VERSION_MINOR, CPA_VERSION_PATCH, 0
 PRODUCTVERSION CPA_VERSION_MAJOR, CPA_VERSION_MINOR, CPA_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CPA Quota"
            VALUE "FileVersion",     CPA_VERSION_STR
            VALUE "InternalName",    "CPAQuota"
            VALUE "OriginalFilename","CPAQuota.dll"
            VALUE "ProductName",     "CPAQuota"
            VALUE "ProductVersion",  CPA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
